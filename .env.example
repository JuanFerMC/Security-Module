# Plantilla de variables de entorno. NO se versionan valores reales.
# OJO: Spring Boot no lee este archivo automaticamente; las variables deben
# estar definidas en el entorno del proceso (terminal, IDE, Docker -e, servidor).
# Ver README.md > "Primer arranque (paso a paso)".

# Base de datos (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/db_scoring
SPRING_DATASOURCE_USERNAME=db_scoring_user
SPRING_DATASOURCE_PASSWORD=<pendiente>

# JWT: clave de al menos 256 bits (32+ bytes). Generar con: openssl rand -base64 48
JWT_SECRET=<generar>
# Vigencia del access token en ms. Maximo 900000 (15 min); la app no arranca si se supera.
JWT_EXPIRATION_MS=900000
# Vigencia del refresh token en dias. Maximo 7.
JWT_REFRESH_EXPIRATION_DAYS=7
# Emisor y audiencia de los tokens; el Motor de Scoring debe validar los mismos.
JWT_ISSUER=crediticio-auth
JWT_AUDIENCE=crediticio-scoring

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Servidor
SERVER_PORT=8081

# Primer administrador (HU08 RF09/RF10). Solo se usan si no existe ningun
# ADMINISTRADOR_RIESGO; despues de creado se ignoran y conviene retirarlas.
INIT_ADMIN_EMAIL=<correo del primer administrador>
INIT_ADMIN_PASSWORD=<minimo 12 caracteres>
INIT_ADMIN_NOMBRE=Administrador
